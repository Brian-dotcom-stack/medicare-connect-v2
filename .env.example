# ─────────────────────────────────────────────────────────────
# Medicare Connect — environment variables
# Copy this file to `.env` for local development.
#
# ⚠️  All `VITE_*` variables are inlined into the browser bundle.
#     NEVER put secrets (service-role key, Stripe secret key) behind
#     the `VITE_` prefix.
# ─────────────────────────────────────────────────────────────

# ── Supabase (client / browser) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# If you use the new-style Supabase API keys, set the publishable key instead:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Supabase (server-only — set these in Vercel → Project → Settings → Env) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# New-style publishable key (server side):
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Bypasses RLS — used by server routes/webhooks only. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Demo mode banner ─────────────────────────────────────────
# Set to "true" to show the "Demo mode" amber banner (fictional data notice).
VITE_DEMO_MODE=false

